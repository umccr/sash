/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Enables `-stub-run` for compile-level validation without real reference data.

    Use as follows:
        nextflow run . -profile test,docker -stub-run --outdir <OUTDIR>

    Known gap: `-stub-run` only validates the pipeline compiles and the include graph
    resolves. It does NOT produce meaningful output data — the `stub:` blocks in most
    sash modules emit placeholder directories/empty files. Real data validation needs
    tier 2 (nf-test), tier 3 (AWS Batch), or tier 4 (ICA).
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input: local samplesheet referencing nf-test fixture directories.
    input = "${projectDir}/assets/test/stub_samplesheet.csv"

    // Reference data: dedicated stub directory with uniquely-named placeholder files
    // so multi-input processes (e.g. ESVEE_CALL) don't collide on identical filenames.
    ref_data_path = "${projectDir}/assets/test/stub/refdata"

    data_versions {
        umccr_reference_data = '2--1'
        hmf_reference_data   = 'unused'
        pcgr                 = 'unused'
        snpeff               = 'unused'
        oncokb               = 'unused'
        appris               = 'unused'
        pon                  = 'unused'
    }

    // Genome paths relative to ref_data_path
    genome {
        fasta = 'genome/genome.fa'
        fai   = 'genome/genome.fa.fai'
        dict  = 'genome/genome.fa.dict'
    }

    // Misc data: pcgr_dir tarball is a real fixture; rest are unique stubs
    miscdata_paths {
        pcgr_dir    = 'pcgr_dir.tar.gz'       // real fixture tarball (538 bytes)
        vep_dir     = 'vep_stub_dir'
        snpeff_dir  = 'snpeff_stub_dir'
        oncokb_genes = 'stub'
        appris      = 'stub'
        pon_dir     = 'pon_stub_dir'
    }

    // HMF data paths — each points at a uniquely-named stub file to avoid input collisions
    hmfdata_paths {
        heterozygous_sites          = 'heterozygous_sites.tsv.gz'
        gc_profile                  = 'gc_profile.cnp'
        diploid_bed                 = 'diploid_bed.bed.gz'
        sv_prep_blocklist           = 'sv_prep_blocklist.bed'
        gridss_pon_breakends        = 'gridss_pon_breakends.bed.gz'
        gridss_pon_breakpoints      = 'gridss_pon_breakpoints.bedpe.gz'
        repeatmasker_annotations    = 'repeatmasker_annotations.fa.gz'
        isofox_counts               = 'isofox_counts.csv'
        isofox_gc_ratios            = 'isofox_gc_ratios.csv'
        clinvar_annotations         = 'clinvar_annotations.vcf.gz'
        sage_blocklist_regions      = 'sage_blocklist_regions.bed'
        sage_highconf_regions       = 'sage_highconf_regions.bed.gz'
        sage_known_hotspots_somatic = 'sage_known_hotspots_somatic.vcf.gz'
        sage_pon                    = 'sage_pon.tsv.gz'
        virus_reporting_db          = 'virus_reporting_db.tsv'
        virus_taxonomy_db           = 'virus_taxonomy_db.tsv'
        gridss_config               = 'gridss_config.properties'
        purple_germline_del         = 'purple_germline_del.csv'
        segment_mappability         = 'segment_mappability.bed.gz'
        cuppa_resources             = 'cuppa_resources'      // directory
        gnomad_resource             = 'gnomad_resource'      // directory
    }

    // UMCCR data paths — unique names under umccr_reference_data/v2--1/
    umccrdata_paths {
        somatic_panel                      = 'somatic_panel.tsv'
        somatic_panel_genes                = 'somatic_panel_genes.txt'
        somatic_panel_genes_ts             = 'somatic_panel_genes_ts.txt'
        somatic_panel_regions_gene         = 'somatic_panel_regions_gene.bed'
        somatic_panel_regions_cds          = 'somatic_panel_regions_cds.bed'
        known_fusion_pairs                 = 'known_fusion_pairs.csv'
        known_fusion_five                  = 'known_fusion_five.csv'
        known_fusion_three                 = 'known_fusion_three.csv'
        germline_panel_genes               = 'germline_panel_genes.txt'
        germline_panel_regions_transcript  = 'germline_panel_regions_transcript.bed'
        hotspots                           = 'hotspots.combined.vcf.gz'
        driver_gene_panel                  = 'driver_gene_panel.tsv'
        sage_known_hotspots_germline       = 'sage_known_hotspots_germline.vcf.gz'
        known_fusions                      = 'known_fusions.bedpe'
        known_fusion_data                  = 'known_fusion_data.csv'
        purple_baf_circos_config           = 'purple_baf_circos_config.conf'
        purple_baf_circos_gaps             = 'purple_baf_circos_gaps.txt'
        annotations_dir                    = 'annotations_dir'           // directory
        ensembl_data_resources             = 'ensembl_data_resources'   // directory
    }
}
